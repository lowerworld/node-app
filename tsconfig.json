{
  "compilerOptions": {
    "esModuleInterop": true,
    "lib": [
      "DOM",
      "ESNext",
      "ESNext.Array",
      "ESNext.Collection",
      "ESNext.Error",
      "ESNext.Iterator",
      "ESNext.Promise"
    ],
    "module": "esnext",
    "moduleResolution": "bundler",
    "skipLibCheck": true,
    "target": "esnext",
    "types": ["node"]
  }
}
